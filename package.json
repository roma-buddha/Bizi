{
  "name": "bizi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A calm personal life organizer. Local-first Life OS for Windows.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "preview": "vite --host 127.0.0.1 --port 7100 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src README.md package.json",
    "package:win": "tauri build --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
